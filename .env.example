# Local builds remain non-indexable by default.
SITE_ENV=preview
# Public main builds set SITE_ENV=production and SITE_VISIBILITY=public.
SITE_VISIBILITY=internal
# Use the owner-confirmed custom domain as the canonical HTTPS origin.
SITE_URL=https://www.navodhai.in
# Public indexing requires SITE_ENV=production and SITE_VISIBILITY=public.
# SITE_URL can override the canonical domain; preview URLs never become canonical.
